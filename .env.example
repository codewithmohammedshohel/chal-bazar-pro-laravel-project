APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Pending orders (not accepted) have their stock reservation released after
# this many hours. Set to 0 to disable automatic expiry.
ORDER_RESERVATION_TTL_HOURS=24
ORDER_RESERVATION_EXPIRY_BATCH_SIZE=100

# Invoice PDF (mPDF + embedded Hind Siliguri font). Set INVOICE_PDF_ENABLED
# to false to hide the PDF download and keep only the printable HTML invoice.
# The Bengali font ships inside the repository, so no remote font is required.
INVOICE_PDF_ENABLED=true
INVOICE_BUSINESS_NAME="Chal Bazar Pro"
INVOICE_BUSINESS_NAME_BN="চাল বাজার প্রো"
INVOICE_BUSINESS_PHONE=
INVOICE_BUSINESS_ADDRESS=

# WhatsApp click-to-chat order confirmation. The destination must be the shop
# number in canonical international format: digits only, no plus sign and no
# separators (Bangladesh example: 8801712345678). Leave it empty to hide the
# WhatsApp button completely. This never sends messages automatically.
WHATSAPP_ENABLED=true
WHATSAPP_BUSINESS_NUMBER=
WHATSAPP_BUSINESS_NAME="${APP_NAME}"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
